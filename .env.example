# Copy to .env. Never commit actual credentials.
APP_ORIGIN=http://localhost:8080
PORT=8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated verified Google emails. Empty = all Google accounts.
ALLOWED_EMAILS=
# Session duration in seconds, renewed on use (max 180 days). Default 90 days.
SESSION_TTL_SECONDS=7776000
# At least 32 random characters. Signs session cookies so they survive restarts.
# Empty: a new key at every start, so restarting the service signs everyone out.
# Changing it signs everyone out on purpose. Never commit the real value.
SESSION_SECRET=
# Enable only behind the private Hermes proxy which overwrites X-Real-IP.
TRUST_PROXY=false

# Gemini disabled by default. Never put this key in client code.
GEMINI_API_KEY=
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-3.5-flash-lite
# local-dev: localhost development only. paid-services: explicit production decision.
# Public EEA clients require Paid Services under the Google API terms.
GEMINI_ACCESS_MODE=
