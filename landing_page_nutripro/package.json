{
  "name": "nutra-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "favicon": "node scripts/gen-favicon.mjs",
    "dev": "npm run favicon && vite",
    "build": "npm run favicon && vite build",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply nutra-waitlist --local",
    "pages:dev": "npm run build && wrangler pages dev --port 8788"
  },
  "devDependencies": {
    "vite": "^6.4.4",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.27"
  }
}
